// Hand-written, except the block between the "generated" markers, which `pnpm generate`
// writes from spec/keywords.json. Lexing follows egglog's `SexpParser` in src/ast/parse.rs.

// egglog reads a file as commands, each a list headed by an atom.
@top Program { TopList* }

@skip { space | LineComment }

// Commands only stand at top level and schedules only nested, which tells the two
// meanings of `run` apart.
TopList[@name=List] { "(" topHead form* ")" }

List { "(" (nestedHead form* | nonAtom form*) ")" }

Unit { "(" ")" }

form { Atom | nonAtom }

nonAtom { List | Unit | value }

value { String | Integer | Float | Bool | Wildcard | Option }

topHead { TopCommandKeyword | ActionKeyword | TopCallee }

nestedHead { NestedCommandKeyword | ActionKeyword | ScheduleKeyword | Callee }

Callee { word }

Atom { word | keyword }

// generated by gen/grammar.mjs from spec/keywords.json
TopCommandKeyword[@name=CommandKeyword] {
  @specialize<word, "birewrite"> |
  @specialize<word, "check"> |
  @specialize<word, "constructor"> |
  @specialize<word, "datatype"> |
  @specialize<word, "datatype*"> |
  @specialize<word, "extract"> |
  @specialize<word, "fail"> |
  @specialize<word, "function"> |
  @specialize<word, "include"> |
  @specialize<word, "input"> |
  @specialize<word, "output"> |
  @specialize<word, "pop"> |
  @specialize<word, "print-function"> |
  @specialize<word, "print-size"> |
  @specialize<word, "print-stats"> |
  @specialize<word, "prove"> |
  @specialize<word, "prove-exists"> |
  @specialize<word, "push"> |
  @specialize<word, "relation"> |
  @specialize<word, "rewrite"> |
  @specialize<word, "rule"> |
  @specialize<word, "ruleset"> |
  @specialize<word, "run"> |
  @specialize<word, "run-schedule"> |
  @specialize<word, "sort"> |
  @specialize<word, "unstable-combined-ruleset">
}

NestedCommandKeyword[@name=CommandKeyword] {
  @specialize<word, "birewrite"> |
  @specialize<word, "check"> |
  @specialize<word, "constructor"> |
  @specialize<word, "datatype"> |
  @specialize<word, "datatype*"> |
  @specialize<word, "extract"> |
  @specialize<word, "fail"> |
  @specialize<word, "function"> |
  @specialize<word, "include"> |
  @specialize<word, "input"> |
  @specialize<word, "output"> |
  @specialize<word, "pop"> |
  @specialize<word, "print-function"> |
  @specialize<word, "print-size"> |
  @specialize<word, "print-stats"> |
  @specialize<word, "prove"> |
  @specialize<word, "prove-exists"> |
  @specialize<word, "push"> |
  @specialize<word, "relation"> |
  @specialize<word, "rewrite"> |
  @specialize<word, "rule"> |
  @specialize<word, "ruleset"> |
  @specialize<word, "run-schedule"> |
  @specialize<word, "sort"> |
  @specialize<word, "unstable-combined-ruleset">
}

ActionKeyword {
  @specialize<word, "delete"> |
  @specialize<word, "let"> |
  @specialize<word, "panic"> |
  @specialize<word, "set"> |
  @specialize<word, "subsume"> |
  @specialize<word, "union">
}

ScheduleKeyword {
  @specialize<word, "repeat"> |
  @specialize<word, "run"> |
  @specialize<word, "saturate"> |
  @specialize<word, "seq">
}

TopCallee[@name=Callee] {
  word |
  @specialize<word, "repeat"> |
  @specialize<word, "saturate"> |
  @specialize<word, "seq">
}

keyword {
  @specialize<word, "birewrite"> |
  @specialize<word, "check"> |
  @specialize<word, "constructor"> |
  @specialize<word, "datatype"> |
  @specialize<word, "datatype*"> |
  @specialize<word, "delete"> |
  @specialize<word, "extract"> |
  @specialize<word, "fail"> |
  @specialize<word, "function"> |
  @specialize<word, "include"> |
  @specialize<word, "input"> |
  @specialize<word, "let"> |
  @specialize<word, "output"> |
  @specialize<word, "panic"> |
  @specialize<word, "pop"> |
  @specialize<word, "print-function"> |
  @specialize<word, "print-size"> |
  @specialize<word, "print-stats"> |
  @specialize<word, "prove"> |
  @specialize<word, "prove-exists"> |
  @specialize<word, "push"> |
  @specialize<word, "relation"> |
  @specialize<word, "repeat"> |
  @specialize<word, "rewrite"> |
  @specialize<word, "rule"> |
  @specialize<word, "ruleset"> |
  @specialize<word, "run"> |
  @specialize<word, "run-schedule"> |
  @specialize<word, "saturate"> |
  @specialize<word, "seq"> |
  @specialize<word, "set"> |
  @specialize<word, "sort"> |
  @specialize<word, "subsume"> |
  @specialize<word, "union"> |
  @specialize<word, "unstable-combined-ruleset">
}
// end generated

// Atoms, numbers, booleans, `_` and options; tokens.ts classifies them as egglog does.
@external tokens atoms from "./tokens" { word, Integer, Float, Bool, Wildcard, Option }

@tokens {
  // Rust's `char::is_whitespace`.
  space { $[\t\n\u{b}\u{c}\r \u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]+ }

  LineComment { ";" ![\n]* }

  String { '"' (!["\\] | "\\" $[nt\\"])* '"' }

  "(" ")"
}

@external propSource egglogHighlighting from "./highlight"

@detectDelim
